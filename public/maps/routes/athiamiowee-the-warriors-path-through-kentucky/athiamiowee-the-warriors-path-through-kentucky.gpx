  <wpt lat="38.7" lon="-83.1">
    <name>Lower Shawneetown (Greenup County)</name>
    <desc>Greenup Co., KY. Greenup Co., KY (&amp; Scioto Co., OH). Approximate.</desc>
  </wpt>
  <wpt lat="38.137" lon="-83.566">
    <name>Scioto prong via Slate Creek country</name>
    <desc>near Olive Hill / Mount Sterling area. Carter–Bath–Montgomery cos., KY. Approximate. Conjectural.</desc>
  </wpt>
  <wpt lat="37.9" lon="-84.0">
    <name>Eskippakithiki (Indian Old Fields)</name>
    <desc>Indian Fields, ~10 mi E of Winchester. Clark Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="37.84" lon="-84.02">
    <name>Red River crossing (near Kentucky River junction)</name>
    <desc>near Clay City / Lulbegrud Creek. Clark–Powell–Estill cos., KY. Approximate.</desc>
  </wpt>
  <wpt lat="37.69" lon="-83.97">
    <name>Kentucky River ford (Station Camp Creek)</name>
    <desc>Irvine. Estill Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="37.40" lon="-83.94">
    <name>War Fork / Sand Gap (KHS marker #697)</name>
    <desc>Gray Hawk (marker on US 421). Jackson Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="37.15" lon="-83.76">
    <name>Goose Creek</name>
    <desc>Manchester. Clay Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="36.838" lon="-83.771">
    <name>Flat Lick</name>
    <desc>Flat Lick. Knox Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="36.749" lon="-83.693">
    <name>Cumberland Ford</name>
    <desc>Pineville. Bell Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="36.604" lon="-83.674">
    <name>Cumberland Gap</name>
    <desc>Middlesboro KY / Cumberland Gap TN. Bell Co., KY; Claiborne Co., TN; Lee Co., VA. Approximate.</desc>
  </wpt>
  <wpt lat="35.53" lon="-84.13">
    <name>Overhill Cherokee towns (Chota)</name>
    <desc>near Vonore, Little Tennessee River (Tellico Lake). Monroe Co., TN. Approximate. Conjectural.</desc>
