  <wpt lat="36.92" lon="-81.80">
    <name>Laurel Fork of Holston, &quot;under a grait mountain&quot;</name>
    <desc>north of Saltville. Smyth/Washington cos., VA. Approximate.</desc>
  </wpt>
  <wpt lat="36.93" lon="-82.28">
