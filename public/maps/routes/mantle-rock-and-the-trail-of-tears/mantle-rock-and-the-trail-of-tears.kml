      <Point><coordinates>-88.243,37.264,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Mantle Rock (winter camps strung along the road)</name>
      <description>near Joy, off KY 133. Livingston Co., KY. Approximate.</description>
      <Point><coordinates>-88.432,37.360,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Berry's Ferry, Ohio River crossing</name>
      <description>opposite Golconda, IL (near Rondeau Island). Livingston Co., KY / Pope Co., IL. Approximate.</description>
      <Point><coordinates>-88.476,37.372,0</coordinates></Point>
    </Placemark>
    <Placemark>
      <name>Mississippi crossing (Green's / Willard's ferries area)</name>
