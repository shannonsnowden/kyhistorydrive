<gpx version="1.1" creator="Kentucky History Drive" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Christopher Gist, 1750–51 (approximate)</name>
    <desc>Approximate waypoints for Christopher Gist, 1750–51. Positions are taken from the story notes and are not a survey. https://kyhistorydrive.com/stories/christopher-gist-1750-51/</desc>
    <link href="https://kyhistorydrive.com/stories/christopher-gist-1750-51/"><text>Christopher Gist, 1750–51</text></link>
  </metadata>
  <wpt lat="39.60" lon="-78.55">
    <name>Col. Thomas Cresap's at Old Town</name>
    <desc>Oldtown. Allegany Co., MD. Approximate.</desc>
  </wpt>
  <wpt lat="40.27" lon="-81.86">
    <name>Wyandot town on the Muskingum</name>
    <desc>Coshocton. Coshocton Co., OH. Approximate.</desc>
  </wpt>
  <wpt lat="38.7" lon="-83.0">
    <name>Lower Shawneetown (&quot;Shannoah Town&quot;), mouth of the Scioto</name>
    <desc>Portsmouth OH / South Portsmouth KY. Scioto Co., OH / Greenup Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="40.18" lon="-84.24">
    <name>Pickawillany (Twightwee town), Great Miami</name>
    <desc>Piqua. Miami Co., OH. Approximate.</desc>
  </wpt>
  <wpt lat="38.71" lon="-83.0">
    <name>ferried over the Ohio into Kentucky</name>
    <desc>South Portsmouth. Greenup Co., KY. Approximate.</desc>
  </wpt>
  <wpt lat="38.55" lon="-84.70">
    <name>lower Salt Lick Creek, &quot;about 15 miles above the Falls&quot;</name>
    <desc>disputed; drawn near Grant/Owen cos.. KY. Approximate. Conjectural.</desc>
  </wpt>
  <wpt lat="38.33" lon="-84.78">
    <name>crosses the &quot;little Cuttaway&quot; (Kentucky River) at an island</name>
    <desc>Kentucky River below Frankfort (approx.). Owen/Henry/Franklin cos., KY. Approximate. Conjectural.</desc>
  </wpt>
  <wpt lat="37.33" lon="-81.20">
    <name>Bluestone River</name>
    <desc>Bluefield–Princeton area. Mercer Co., WV / Tazewell Co., VA. Approximate.</desc>
  </wpt>
  <wpt lat="37.56" lon="-80.85">
    <name>crosses the New River by raft, ~8 mi above the Bluestone mouth</name>
    <desc>near Hinton. Summers Co., WV. Approximate.</desc>
  </wpt>
  <wpt lat="37.36" lon="-80.53">
    <name>mountain pond (Mountain Lake), Sinking Creek</name>
    <desc>Mountain Lake. Giles Co., VA. Approximate.</desc>
  </wpt>
  <wpt lat="37.18" lon="-80.35">
    <name>Richard Hall's, farthest settler on the New River</name>
    <desc>near Blacksburg. Montgomery Co., VA. Approximate.</desc>
  </wpt>
  <wpt lat="36.12" lon="-80.55">
    <name>Carolina line; home on the Yadkin</name>
    <desc>upper Yadkin (exact homestead uncertain). Surry/Yadkin/Davie cos., NC. Approximate.</desc>
  </wpt>
