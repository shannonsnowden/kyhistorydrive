  "storySlug": "father-david-rice-and-kentuckys-first-presbyterian-churches",
  "title": "Father David Rice and Kentucky’s first Presbyterian churches",
  "updated": "2026-10-19",
  "summary": "Father David Rice organized Concord Church at Danville in 1784, argued for gradual emancipation in 1792, and later preached from his home near Greensburg.",
  "sections": [
    {
      "heading": "Arrival and churches",
      "items": [
        {
          "text": "Rice came to Kentucky in 1783 and organized Concord Church at Danville in 1784; the church counts it first of four that year, marker 754 says one of three. Congregation moved to Main Street in 1789.",
          "sources": [
            "pres",
            "khs-754"
          ]
        }
      ]
    },
    {
      "heading": "Teacher and presbytery",
      "items": [
        {
          "text": "Founded Rice's School / Transylvania Seminary near Danville in 1785 (marker 844); first moderator of the Transylvania Presbytery.",
          "sources": [
            "khs-844",
            "pres"
          ]
        }
      ]
    },
    {
      "heading": "1792 convention",
      "items": [
        {
          "text": "Delegate to the 1792 convention; argued for gradual emancipation in Slavery, Inconsistent with Justice and Good Policy; failed; Article IX protected slavery.",
          "sources": [
            "ekh",
            "pres"
          ]
        }
      ]
    },
    {
      "heading": "Green County",
      "items": [
        {
          "text": "Church history: moved to Green County 1793. Marker 844: came to Greensburg area 1798, formed two churches. Died 1816 in Green County, buried at Danville.",
          "sources": [
            "pres",
            "khs-844",
            "wp"
          ]
        }
      ]
    }
  ],
