  <wpt lat="38.0008" lon="-85.764">
    <name>4. Bullitt&apos;s Lick marker (KHS #133)</name>
    <desc>Visiting: Marker only. Marker only</desc>
  </wpt>
  <wpt lat="37.9943" lon="-85.9427">
    <name>5. Fort Duffield Park &amp; Historic Site</name>
    <desc>Visiting: Public park with trails; open daylight hours.</desc>
