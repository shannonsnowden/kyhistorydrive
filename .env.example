# CARTO basemap API key (free): https://carto.com/basemaps/apikey/
# Set in Amplify Hosting → Environment variables, then redeploy.
# Do not commit a real key — this repo is public.
VITE_CARTO_API_KEY=

# Optional later: MapTiler / Stadia vector style URL
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# Optional: GitHub token with read access to private repo shannonsnowden/ky-markers-drive.
# Used by `npm run sync-app-data` (and Amplify preBuild) to pull iOS JSON into public/data/app/.
# Without it, the committed files in public/data/app/ are published as-is.
# KY_MARKERS_DRIVE_GITHUB_TOKEN=
