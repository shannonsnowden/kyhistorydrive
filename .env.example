# CARTO basemap API key (free): https://carto.com/basemaps/apikey/
# Set in Amplify Hosting → Environment variables, then redeploy.
# Do not commit a real key — this repo is public.
VITE_CARTO_API_KEY=

# Optional later: MapTiler / Stadia vector style URL
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_KEY

# Ad slots are off in production unless this is true or 1.
# Any build can be previewed with ?adpreview=1 (put the query before the hash:
# /?adpreview=1#explore/daily/2). ?adpreview=0 forces slots off.
# VITE_ADS_ENABLED=
#
# Public AdSense publisher id. The slot code falls back to ca-pub-8587137224654033
# when this is unset. Do not put a secret here. The head tag and /ads.txt
# already ship with the site; slots reuse that tag.
# VITE_ADSENSE_CLIENT=
#
# Numeric ad-unit ids from AdSense. Leave unset until the account is approved:
# the slot stays a same-size placeholder and does not request an ad.
# VITE_ADSENSE_SLOT_HOME=
# VITE_ADSENSE_SLOT_SIDEBAR=
# VITE_ADSENSE_SLOT_EXPLORE=

# Optional: GitHub token with read access to private repo shannonsnowden/ky-markers-drive.
# Used by `npm run sync-app-data` (and Amplify preBuild) to pull iOS JSON into public/data/app/.
# Without it, the committed files in public/data/app/ are published as-is.
# KY_MARKERS_DRIVE_GITHUB_TOKEN=
